{
  "name": "@zacksonpessoa/usdc-payments-sdk",
  "version": "0.3.2-mvp",
  "description": "One-line checkout SDK to pay with USDC on Stellar (Web + Mobile).",
  "license": "ISC",
  "author": "Zackson Pessoa",
  "homepage": "https://github.com/ZacksonPessoa/USDC-Payments-SDK-for-Stellar-Web-Mobile-",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZacksonPessoa/USDC-Payments-SDK-for-Stellar-Web-Mobile-.git"
  },
  "bugs": {
    "url": "https://github.com/ZacksonPessoa/USDC-Payments-SDK-for-Stellar-Web-Mobile-/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "verify": "node scripts/verify-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:webhook": "npm run build && node examples/secure-server-example.mjs",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "stellar-sdk": "^13.3.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sqlite3": "3.1.11",
    "@vitest/coverage-v8": "^2.1.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sqlite3": "^5.1.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
