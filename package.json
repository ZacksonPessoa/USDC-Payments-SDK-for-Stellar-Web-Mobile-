{
  "name": "@zacksonpessoa/usdc-payments-sdk",
  "version": "0.3.0-mvp",
  "description": "One-line checkout SDK to pay with USDC on Stellar (Web + Mobile).",
  "license": "ISC",
  "author": "Zackson Pessoa",
  "homepage": "https://github.com/ZacksonPessoa/USDC-Payments-SDK-for-Stellar-Web-Mobile-",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZacksonPessoa/USDC-Payments-SDK-for-Stellar-Web-Mobile-.git"
  },
  "bugs": {
    "url": "https://github.com/ZacksonPessoa/USDC-Payments-SDK-for-Stellar-Web-Mobile-/issues"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:webhook": "npm run build && node examples/secure-server-example.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sqlite3": "5.1.7",
    "stellar-sdk": "^13.3.0"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sqlite3": "3.1.11",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
