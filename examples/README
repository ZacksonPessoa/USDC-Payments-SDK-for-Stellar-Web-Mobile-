## 💻 Code Examples

### Basic Integration

```tsx
import React from "react";
import { PayWithUSDC } from "../../dist/index.js";
import type { WalletAdapter } from "../../src/types";

// Mock wallet for demonstration
const mockWallet: WalletAdapter = {
  getPublicKey: async () => "GDGDU4ZDA2ALEOT3WP5KTQIAC7NYGTFJY65VFBMSIO4YA4EOD72W7MVY",
  signAndSubmit: async (xdr: string, network: "TESTNET" | "PUBLIC") => {
    console.log("Mock: Signing transaction...");
    return { hash: "mock-transaction-hash-" + Date.now() };
  }
};

export default function Home() {
  return (
    <div style={{ padding: 32 }}>
      <h1>🎉 Stellar USDC Payments SDK Demo</h1>
      
    <PayWithUSDC
      amount={1}
      assetCode="XLM"
        destination="GBZXN7PIRZGNMHGAJ3K4KDFKJ7B3KFW2LLAV7POXNRJBI2R6BQR6E3RH"
        wallet={mockWallet}
        onSuccess={(hash: string) => alert(`✅ Payment sent! Hash: ${hash}`)}
        onError={(error: unknown) => alert(`❌ Error: ${error}`)}
      />
    </div>
  );
}
```

### USDC Payment Example

```tsx
<PayWithUSDC
  amount={50}
  assetCode="USDC"
  issuer="GADGV62S2PRYD4HGRB3DPSYRH64X2EXMNPPTELVD4EKJ6LFL76STFGSL"
  destination="GDESTINATIONADDRESS..."
  wallet={wallet}
  memo="Payment for order #123"
  label="Pay with USDC"
  onSuccess={(hash) => console.log('USDC payment confirmed:', hash)}
  onError={(error) => console.error('USDC payment failed:', error)}
/>
```

### Custom Styling

```tsx
<PayWithUSDC
  amount={25}
  destination="GDESTINATIONADDRESS..."
  wallet={wallet}
  label="💳 Pay Now"
  onSuccess={(hash) => {
    // Custom success handling
    setPaymentStatus('completed');
    setTransactionHash(hash);
  }}
  onError={(error) => {
    // Custom error handling
    setPaymentStatus('failed');
    setErrorMessage(error.message);
  }}
/>
```

