{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "jsx": "react-jsx",
  
      "declaration": false,         
      "declarationMap": false,      
      "sourceMap": true,            
  
      "moduleResolution": "Bundler",
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "isolatedModules": true,      
  
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
  
      "outDir": "./dist",           
      "baseUrl": "."
    },
    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"]
  }
  